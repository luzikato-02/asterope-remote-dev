# Server configuration
PORT=4000
NODE_ENV=production

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-long-random-secret-string
DASHBOARD_PASSWORD=changeme

# Where workspaces are stored on disk
DATA_DIR=/var/asterope

# code-server configuration
STARTING_PORT=8100

# The public hostname/IP of your VPS (used to build workspace URLs)
# Examples: 192.168.1.100  or  dev.yourdomain.com
VPS_HOST=your-vps-ip-or-domain

# Frontend URL (for CORS in development)
ALLOWED_ORIGIN=http://localhost:5173

# Session duration
TOKEN_EXPIRY=24h
